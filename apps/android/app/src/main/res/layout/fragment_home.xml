<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="24dp"
    android:paddingBottom="32dp">

    <TextView
      android:id="@+id/home_title"
      style="@style/QletterText.Title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/tab_home" />

    <ProgressBar
      android:id="@+id/home_loading"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="4dp"
      android:indeterminate="true"
      android:visibility="gone"
      android:contentDescription="@string/home_loading" />

    <TextView
      android:id="@+id/home_error"
      style="@style/QletterText.Error"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:visibility="gone"
      android:accessibilityLiveRegion="polite" />

    <Button
      android:id="@+id/home_refresh"
      style="@style/QletterButton.Default"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/home_refresh" />

    <LinearLayout
      android:id="@+id/home_content"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <TextView
        android:id="@+id/home_counts"
        style="@style/QletterText.Sm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

      <TextView
        android:id="@+id/home_attention"
        style="@style/QletterText.Sm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

      <Button
        android:id="@+id/home_summarize"
        style="@style/QletterButton.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/home_summarize" />

      <TextView
        android:id="@+id/home_recent_title"
        style="@style/QletterText.Subhead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/home_recent" />

      <Button
        android:id="@+id/home_all_reports"
        style="@style/QletterButton.Default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/home_all_reports" />

      <TextView
        android:id="@+id/home_empty"
        style="@style/QletterText.Sm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/home_empty" />

      <LinearLayout
        android:id="@+id/home_recent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

      <Button
        android:id="@+id/home_check"
        style="@style/QletterButton.Default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/home_check" />

      <TextView
        android:id="@+id/home_check_notice"
        style="@style/QletterText.Xs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/home_check_notice" />

      <TextView
        android:id="@+id/home_check_times"
        style="@style/QletterText.Xs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

      <ProgressBar
        android:id="@+id/home_check_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone"
        android:contentDescription="@string/home_check_pending" />

      <TextView
        android:id="@+id/home_check_status"
        style="@style/QletterText.Sm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        android:accessibilityLiveRegion="polite" />

      <TextView
        android:id="@+id/home_check_error"
        style="@style/QletterText.Error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        android:accessibilityLiveRegion="polite" />

      <Button
        android:id="@+id/home_check_refresh"
        style="@style/QletterButton.Default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/home_check_refresh" />

    </LinearLayout>

  </LinearLayout>

</androidx.core.widget.NestedScrollView>
