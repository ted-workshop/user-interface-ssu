<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="24dp"
    android:paddingBottom="32dp">

    <TextView
      android:id="@+id/summary_title"
      style="@style/QletterText.Title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/page_summary" />

    <TextView
      android:id="@+id/summary_intro"
      style="@style/QletterText.Sm"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/summary_intro" />

    <EditText
      android:id="@+id/summary_url"
      style="@style/QletterInput"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:hint="@string/summary_url_hint"
      android:inputType="textUri"
      android:imeOptions="actionGo"
      android:maxLength="2048"
      android:importantForAutofill="no"
      android:saveEnabled="false" />

    <Button
      android:id="@+id/summary_submit"
      style="@style/QletterButton.Primary"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/summary_submit" />

    <TextView
      android:id="@+id/summary_notice"
      style="@style/QletterText.Xs"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/summary_notice" />

    <ProgressBar
      android:id="@+id/summary_loading"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="4dp"
      android:indeterminate="true"
      android:visibility="gone"
      android:contentDescription="@string/summary_loading" />

    <TextView
      android:id="@+id/summary_error"
      style="@style/QletterText.Error"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:visibility="gone"
      android:accessibilityLiveRegion="polite" />

    <LinearLayout
      android:id="@+id/summary_current"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

      <TextView
        android:id="@+id/summary_request_title"
        style="@style/QletterText.Subhead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/summary_request_title" />

      <TextView
        android:id="@+id/summary_status"
        style="@style/QletterText.SmStrong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:accessibilityLiveRegion="polite" />

      <TextView
        android:id="@+id/summary_video"
        style="@style/QletterText.Xs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

      <TextView
        android:id="@+id/summary_explanation"
        style="@style/QletterText.Sm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

      <Button
        android:id="@+id/summary_retry"
        style="@style/QletterButton.Default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/summary_retry" />

      <Button
        android:id="@+id/summary_read"
        style="@style/QletterButton.Default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/summary_read" />

      <Button
        android:id="@+id/summary_another"
        style="@style/QletterButton.Default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/summary_another" />

    </LinearLayout>

    <Button
      android:id="@+id/summary_refresh"
      style="@style/QletterButton.Default"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/summary_refresh" />

    <TextView
      android:id="@+id/summary_history_title"
      style="@style/QletterText.Subhead"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/summary_history_title" />

    <Button
      android:id="@+id/summary_history_refresh"
      style="@style/QletterButton.Default"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/summary_history_refresh" />

    <TextView
      android:id="@+id/summary_history_error"
      style="@style/QletterText.Error"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:visibility="gone"
      android:accessibilityLiveRegion="polite" />

    <TextView
      android:id="@+id/summary_empty"
      style="@style/QletterText.Sm"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:text="@string/summary_empty" />

    <LinearLayout
      android:id="@+id/summary_history"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical" />

    <Button
      android:id="@+id/summary_more"
      style="@style/QletterButton.Default"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="@string/summary_more" />

  </LinearLayout>

</androidx.core.widget.NestedScrollView>
