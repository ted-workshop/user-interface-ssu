<resources>
    <!-- 입력창: 피그마의 1dp 테두리 사각형과 같은 모양이에요. -->
    <style name="QletterInput" parent="">
        <item name="android:background">@drawable/q_input</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/q_ink_strong</item>
        <item name="android:textColorHint">@color/q_ink_placeholder</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="QletterText.Link" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/q_ink_strong</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="QletterText.Error" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/q_state_danger</item>
        <item name="android:lineSpacingExtra">3sp</item>
    </style>

    <style name="QletterText.Notice" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/q_state_ok</item>
        <item name="android:lineSpacingExtra">3sp</item>
    </style>
</resources>
