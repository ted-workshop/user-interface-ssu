<resources>
    <!-- 피그마 Button/primary: 보이는 높이 40, 좌우 16. 위아래 inset 4로 터치 영역은 48을 지켜요. -->
    <style name="QletterButton.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/q_ink_on_ink</item>
        <item name="backgroundTint">@color/q_ink_strong</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- 피그마 Button/default: 흰 바탕, 회색 테두리 알약 버튼 -->
    <style name="QletterButton.Default" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/q_ink_strong</item>
        <item name="backgroundTint">@color/q_bg_default</item>
        <item name="strokeColor">@color/q_line_strong</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- 피그마 Button/danger: default 모양에 빨간 글자 -->
    <style name="QletterButton.Danger" parent="QletterButton.Default">
        <item name="android:textColor">@color/q_state_danger</item>
    </style>

    <!-- 피그마 Title 28 / Subhead 18 / Sm 15 / Xs 13 -->
    <style name="QletterText.Title" parent="">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.035</item>
        <item name="android:textColor">@color/q_ink_strong</item>
    </style>

    <style name="QletterText.Subhead" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.038</item>
        <item name="android:textColor">@color/q_ink_strong</item>
    </style>

    <style name="QletterText.SmStrong" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/q_ink_strong</item>
    </style>

    <style name="QletterText.Sm" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textColor">@color/q_ink_subtle</item>
    </style>

    <style name="QletterText.Xs" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/q_ink_muted</item>
    </style>

    <!-- 피그마 Bottom Sheet: 흰 바탕, 위쪽 모서리 16. Material3의 높이 색 덧입힘을 꺼서 흰색이 그대로 보여요. -->
    <style name="ThemeOverlay.Qletter.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Qletter.BottomSheet</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSurfaceContainerLow">@color/q_bg_default</item>
        <item name="colorSurfaceContainerHigh">@color/q_bg_default</item>
        <item name="android:navigationBarColor">@color/q_bg_default</item>
    </style>

    <style name="Widget.Qletter.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/q_bg_default</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Qletter.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Qletter.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- 피그마 확인창(61:132): 떠 있는 창 안의 흰 버튼에 Material3 높이 색이 덧입혀지지 않게 해요. -->
    <style name="ThemeOverlay.Qletter.Dialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="elevationOverlayEnabled">false</item>
    </style>
</resources>
