<?xml version="1.0" encoding="utf-8"?>
<!-- 피그마 60:88 모음 상세: 뒤로가기, 제목·요약, 이름 바꾸기·모음 삭제, 리포트 목록, 안내 박스 -->
<!-- 화면 전체를 한 번에 스크롤해요. 가로 화면에서도 목록이 보이고, 더 보기는 목록 바로 아래에 와요(ADR-0048). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/main"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true"
  android:paddingStart="16dp"
  android:paddingTop="32dp"
  android:paddingEnd="16dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
      android:id="@+id/detail_back"
      style="@style/QletterText.Sm"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="?attr/selectableItemBackground"
      android:text="@string/collection_detail_back" />

    <TextView
      android:id="@+id/detail_name"
      style="@style/QletterText.Title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      tools:text="AI 공부" />

    <TextView
      android:id="@+id/detail_count"
      style="@style/QletterText.Sm"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      tools:text="리포트 2편 · 최근에 만든 리포트부터 보여요." />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:orientation="horizontal">

      <Button
        android:id="@+id/detail_rename_button"
        style="@style/QletterButton.Default"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/collection_rename" />

      <Button
        android:id="@+id/detail_delete_button"
        style="@style/QletterButton.Danger"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/collection_delete_collection" />
    </LinearLayout>

    <!-- 목록은 스크롤 안에서 모든 줄을 그려요. 20개씩만 받아서 감수해요. 비었을 때 안내가 가운데 오게 최소 높이를 둬요. -->
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:minHeight="200dp">

      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/detail_reports_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false" />

      <ProgressBar
        android:id="@+id/detail_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

      <LinearLayout
        android:id="@+id/detail_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
          android:id="@+id/detail_message"
          style="@style/QletterText.Sm"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:accessibilityLiveRegion="polite"
          android:paddingStart="24dp"
          android:paddingEnd="24dp" />

        <Button
          android:id="@+id/detail_retry"
          style="@style/QletterButton.Default"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="@string/collection_retry"
          android:visibility="gone" />
      </LinearLayout>
    </FrameLayout>

    <!-- 20개씩 받아요. 서버에 더 있으면 목록 아래에서 이어 받아요. -->
    <Button
      android:id="@+id/detail_more"
      style="@style/QletterButton.Default"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center_horizontal"
      android:layout_marginTop="8dp"
      android:text="@string/collection_more"
      android:textColor="@color/q_button_default_text"
      android:visibility="gone" />

    <TextView
      android:id="@+id/detail_more_error"
      style="@style/QletterText.Xs"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:accessibilityLiveRegion="polite"
      android:gravity="center"
      android:textColor="@color/q_state_danger"
      android:visibility="gone" />

    <!-- 내용이 짧을 때 안내 박스를 화면 아래에 둬요. -->
    <Space
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />

    <TextView
      style="@style/QletterText.Xs"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:layout_marginBottom="16dp"
      android:background="@drawable/q_soft_box"
      android:paddingStart="20dp"
      android:paddingTop="16dp"
      android:paddingEnd="20dp"
      android:paddingBottom="16dp"
      android:text="@string/collection_detail_note"
      android:textColor="@color/q_ink_subtle" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
