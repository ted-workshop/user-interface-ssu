<?xml version="1.0" encoding="utf-8"?>
<!-- 피그마 60:88 모음 상세: 뒤로가기, 제목·요약, 이름 바꾸기·모음 삭제, 리포트 목록, 안내 박스 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/main"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:paddingStart="16dp"
  android:paddingTop="32dp"
  android:paddingEnd="16dp">

  <TextView
    android:id="@+id/detail_back"
    style="@style/QletterText.Sm"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:text="@string/collection_detail_back" />

  <TextView
    android:id="@+id/detail_name"
    style="@style/QletterText.Title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    tools:text="AI 공부" />

  <TextView
    android:id="@+id/detail_count"
    style="@style/QletterText.Sm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    tools:text="리포트 2편 · 최근에 만든 리포트부터 보여요." />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:orientation="horizontal">

    <Button
      android:id="@+id/detail_rename_button"
      style="@style/QletterButton.Default"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/collection_rename" />

    <Button
      android:id="@+id/detail_delete_button"
      style="@style/QletterButton.Danger"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:text="@string/collection_delete_collection" />
  </LinearLayout>

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="20dp"
    android:layout_weight="1">

    <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/detail_reports_list"
      android:layout_width="match_parent"
      android:layout_height="match_parent" />

    <ProgressBar
      android:id="@+id/detail_loading"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:visibility="gone" />

    <LinearLayout
      android:id="@+id/detail_state"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      android:visibility="gone">

      <TextView
        android:id="@+id/detail_message"
        style="@style/QletterText.Sm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp" />

      <Button
        android:id="@+id/detail_retry"
        style="@style/QletterButton.Default"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/collection_retry"
        android:visibility="gone" />
    </LinearLayout>
  </FrameLayout>

  <TextView
    android:id="@+id/detail_more"
    style="@style/QletterText.Xs"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:visibility="gone" />

  <TextView
    style="@style/QletterText.Xs"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/q_soft_box"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp"
    android:text="@string/collection_detail_note"
    android:textColor="@color/q_ink_subtle" />
</LinearLayout>
