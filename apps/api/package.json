{
  "name": "@qletter/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "types": "wrangler types --include-runtime=false --strict-vars=false",
    "types:check": "wrangler types --include-runtime=false --strict-vars=false --check",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "typecheck": "bun run --bun tsc --noEmit && bun run --bun tsc --noEmit -p test/tsconfig.json && bun run --bun tsc --noEmit -p tools/tsconfig.json",
    "test": "vitest run && bun test tools",
    "email": "bun tools/email.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "bun run types:check && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "hono": "4.13.12",
    "nodemailer": "10.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "24.19.2",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
