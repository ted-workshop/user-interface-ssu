<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/signup_back"
            style="@style/QletterText.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:drawableStartCompat="@drawable/ic_arrow_back"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:text="@string/auth_back_login" />

        <TextView
            style="@style/QletterText.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/auth_signup_title" />

        <TextView
            style="@style/QletterText.Sm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auth_signup_subtitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/auth_email"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/signup_email"
            style="@style/QletterInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="emailAddress"
            android:hint="@string/auth_email_hint"
            android:imeOptions="actionNext"
            android:inputType="textEmailAddress"
            android:maxLength="254" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/auth_nickname"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/signup_nickname"
            style="@style/QletterInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="name"
            android:hint="@string/auth_nickname_hint"
            android:imeOptions="actionNext"
            android:inputType="textPersonName|textCapWords" />

        <TextView
            style="@style/QletterText.Xs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/auth_nickname_help" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/auth_password"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/signup_password"
            style="@style/QletterInput"
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="newPassword"
            android:hint="@string/auth_password_hint"
            android:imeOptions="actionNext"
            android:inputType="textPassword" />

        <TextView
            style="@style/QletterText.Xs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/auth_password_help" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/auth_password_confirm"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/signup_password_confirm"
            style="@style/QletterInput"
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="newPassword"
            android:hint="@string/auth_password_confirm_hint"
            android:imeOptions="actionDone"
            android:inputType="textPassword" />

        <CheckBox
            android:id="@+id/signup_agree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/auth_agree"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/signup_error"
            style="@style/QletterText.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"
            tools:text="가입하지 못했어요." />

        <Button
            android:id="@+id/signup_submit"
            style="@style/QletterButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/auth_signup_submit" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/QletterText.Xs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auth_have_account" />

            <TextView
                android:id="@+id/signup_login"
                style="@style/QletterText.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center"
                android:layout_marginStart="4dp"
                android:padding="8dp"
                android:text="@string/auth_go_login" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
