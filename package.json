{
  "name": "qletter",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "api:dev": "bun run --cwd apps/api dev",
    "api:check": "bun run lint && bun run typecheck:tools && bun run --cwd apps/api check && bun test scripts",
    "android:check": "bun scripts/android.ts check",
    "check": "bun run api:check && bun run android:check",
    "lint": "bun run --bun biome check .",
    "format": "bun run --bun biome format --write .",
    "typecheck:tools": "bun run --bun tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
