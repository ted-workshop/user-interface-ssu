    users {
        text id PK "계정 ID"
        text email UK "정규화한 이메일, 공개 응답 제외"
        text nickname "댓글 작성자 표시"
        text password_hash "비밀번호 hash"
        integer email_verified_at "확인 전 NULL"
        integer created_at "가입 시각"
    }
    sessions {
        text id PK "세션 ID"
        text user_id FK "users.id"
        text token_hash UK "원문 토큰 대신 hash"
        integer created_at "생성 시각"
        integer expires_at "절대 만료 시각"
    }
    user_settings {
        text user_id PK, FK "users.id"
        integer check_interval_minutes "60 / 360 / 1440"
    }
    account_tokens {
        text id PK "일회용 토큰 ID"
        text user_id FK "users.id"
        text purpose "verify_email / reset_password / verify_recipient"
        text recipient_id FK "recipients.id, 수신 주소 확인일 때만 연결"
        text token_hash UK "원문 토큰 대신 hash"
        integer created_at "생성 시각"
        integer expires_at "만료 시각"
        integer consumed_at "소비 전 NULL"
    }
    channels {
        text id PK "공통 채널 ID"
        text youtube_channel_id UK "원본 채널 ID"
        text title "실제 출처의 채널명"
        text url "확인한 채널 URL"
        integer created_at "최초 기록 시각"
    }
    videos {
        text id PK "정규화한 YouTube video ID"
        text channel_id FK "channels.id, 출처 확인 전 NULL"
        text title "출처 확인 전 NULL"
        integer published_at "게시 시각, 미확인 시 NULL"
        integer created_at "최초 기록 시각"
    }
    channel_subscriptions {
        text id PK "개인 구독 ID"
        text user_id FK "users.id"
        text channel_id FK "channels.id"
        text status "active / paused / deleted"
