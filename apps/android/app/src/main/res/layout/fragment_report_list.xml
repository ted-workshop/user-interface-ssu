<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:paddingStart="16dp"
  android:paddingEnd="16dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginTop="12dp">

    <EditText
      android:id="@+id/report_search"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_weight="1"
      android:hint="@string/report_search_hint"
      android:inputType="text"
      android:imeOptions="actionSearch"
      android:singleLine="true"
      android:autofillHints=""
      android:background="@drawable/q_input"
      android:textSize="15sp"
      android:paddingStart="12dp"
      android:paddingEnd="12dp" />

    <Button
      android:id="@+id/report_search_button"
      style="@style/QletterButton.Default"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:text="@string/report_search" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <Spinner
      android:id="@+id/report_origin"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_weight="1"
      android:contentDescription="@string/report_origin_filter" />

    <Spinner
      android:id="@+id/report_delivery"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_weight="1"
      android:contentDescription="@string/report_delivery_filter" />
  </LinearLayout>

  <TextView
    android:id="@+id/report_channel"
    style="@style/QletterText.Xs"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone" />

  <Button
    android:id="@+id/report_reset"
    style="@style/QletterButton.Default"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/report_reset"
    android:visibility="gone" />

  <ProgressBar
    android:id="@+id/report_loading"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="4dp"
    android:indeterminate="true"
    android:contentDescription="@string/report_loading"
    android:visibility="gone" />

  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/report_list"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:clipToPadding="false"
    android:paddingBottom="8dp" />

  <TextView
    android:id="@+id/report_message"
    style="@style/QletterText.Sm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:padding="16dp"
    android:accessibilityLiveRegion="polite"
    android:visibility="gone" />

  <Button
    android:id="@+id/report_retry"
    style="@style/QletterButton.Default"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:text="@string/report_retry"
    android:visibility="gone" />

  <Button
    android:id="@+id/report_more"
    style="@style/QletterButton.Default"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/report_more"
    android:visibility="gone" />
</LinearLayout>
