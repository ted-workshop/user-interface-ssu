<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="32dp"
    android:orientation="vertical">
    <TextView android:id="@+id/tab_title" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="26sp" android:textStyle="bold" />
    <TextView android:id="@+id/session_status" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:textColor="@color/q_ink_subtle" android:visibility="gone" />
</LinearLayout>
