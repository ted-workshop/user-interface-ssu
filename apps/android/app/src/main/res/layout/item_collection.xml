<?xml version="1.0" encoding="utf-8"?>
<!-- 피그마 Row/AI 공부: 아이콘·이름·리포트 수 한 줄, 그 아래 이름 바꾸기·삭제 버튼, 아래 구분선 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <LinearLayout
    android:id="@+id/collection_open"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:layout_width="40dp"
      android:layout_height="40dp"
      android:background="@drawable/q_circle_soft"
      android:gravity="center"
      android:importantForAccessibility="no"
      android:text="@string/collection_folder_mark"
      android:textColor="@color/q_ink_subtle"
      android:textSize="15sp" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/collection_name"
        style="@style/QletterText.Subhead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="AI 공부" />

      <TextView
        android:id="@+id/collection_count"
        style="@style/QletterText.Xs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        tools:text="리포트 2편" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="12dp"
    android:orientation="horizontal">

    <Button
      android:id="@+id/collection_rename_button"
      style="@style/QletterButton.Default"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/collection_rename" />

    <Button
      android:id="@+id/collection_delete_button"
      style="@style/QletterButton.Danger"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:text="@string/collection_delete" />
  </LinearLayout>

  <View
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:background="@color/q_line_default" />
</LinearLayout>
