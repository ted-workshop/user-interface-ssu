<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/channel_title"
            style="@style/QletterText.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/channel_title" />

        <TextView
            style="@style/QletterText.Sm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/channel_subtitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/q_input"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="0dp">

            <EditText
                android:id="@+id/channel_search_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/channel_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="2048"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textColor="@color/q_ink_strong"
                android:textColorHint="@color/q_ink_placeholder"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/channel_search_button"
                style="@style/QletterText.Link"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="56dp"
                android:paddingStart="8dp"
                android:paddingEnd="14dp"
                android:text="@string/channel_find" />
        </LinearLayout>

        <TextView
            android:id="@+id/channel_search_error"
            style="@style/QletterText.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"
            tools:text="이미 등록한 채널이에요." />

        <LinearLayout
            android:id="@+id/channel_preview_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/q_soft_box"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/channel_preview_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/q_circle_soft"
                    android:gravity="center"
                    android:textColor="@color/q_ink_strong"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="지" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/channel_preview_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/q_ink_strong"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="지식한입" />

                    <TextView
                        android:id="@+id/channel_preview_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/q_ink_muted"
                        android:textSize="13sp"
                        tools:text="@지식한입" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/QletterText.Xs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/channel_preview_help" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/channel_preview_cancel"
                    style="@style/QletterButton.Default"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_cancel" />

                <Button
                    android:id="@+id/channel_preview_register"
                    style="@style/QletterButton.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/channel_register" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/channel_count"
            style="@style/QletterText.Subhead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:visibility="gone"
            tools:text="등록한 채널 3" />

        <ProgressBar
            android:id="@+id/channel_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:contentDescription="@string/common_loading" />

        <LinearLayout
            android:id="@+id/channel_error_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/channel_error"
                style="@style/QletterText.Sm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/q_state_danger"
                tools:text="채널을 불러오지 못했어요." />

            <Button
                android:id="@+id/channel_retry"
                style="@style/QletterButton.Default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/common_retry" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/channel_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/QletterText.Subhead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/channel_empty_title" />

            <TextView
                style="@style/QletterText.Xs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/channel_empty_help" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channel_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:nestedScrollingEnabled="false"
            android:visibility="gone"
            tools:itemCount="2"
            tools:listitem="@layout/item_channel" />

        <TextView
            android:id="@+id/channel_more"
            style="@style/QletterText.Xs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            tools:text="최근에 등록한 채널 100개까지 보여요." />
    </LinearLayout>
</ScrollView>
