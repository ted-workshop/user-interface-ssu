<?xml version="1.0" encoding="utf-8"?>
<!-- 피그마 Report Link: 썸네일 자리, 제목, 채널·날짜·출처·발송 상태. 모음 상세에서는 제목 오른쪽에 빼기를 둬요. 줄을 누르면 리포트 상세를 열어요. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginBottom="4dp"
  android:foreground="?attr/selectableItemBackground"
  android:orientation="horizontal"
  android:padding="8dp">

  <View
    android:layout_width="112dp"
    android:layout_height="63dp"
    android:background="@drawable/q_video_thumb" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <!-- 글자 기준선을 맞추지 않아요. 맞추면 제목이 빼기 버튼 글자 높이로 밀려 잘려요. -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:baselineAligned="false"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/report_title"
        style="@style/QletterText.SmStrong"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        tools:text="왜 앱의 80%가 사라진다고 말하는가" />

      <!-- 피그마에 없는 동작이라 댓글 삭제와 같은 글자 버튼으로 둬요(ADR-0048).
           누르는 영역은 48dp로 두고, 위아래 음수 여백으로 줄 높이는 늘리지 않아요.
           채널·날짜 줄은 피그마처럼 전체 너비를 써요. -->
      <TextView
        android:id="@+id/report_remove"
        style="@style/QletterText.Xs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="-14dp"
        android:layout_marginBottom="-14dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:text="@string/collection_remove"
        android:textColor="@color/q_ink_subtle" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <TextView
        android:id="@+id/report_channel"
        style="@style/QletterText.Xs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="@ycombinator · 오늘" />

      <TextView
        android:id="@+id/report_origin"
        style="@style/QletterText.Xs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:maxLines="1"
        tools:text="직접 요약" />

      <TextView
        android:id="@+id/report_delivery_failed"
        style="@style/QletterText.Xs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:drawableStartCompat="@drawable/q_status_dot_danger"
        android:drawablePadding="6dp"
        android:maxLines="1"
        android:text="@string/report_delivery_failed"
        android:textColor="@color/q_state_danger"
        android:visibility="gone" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
