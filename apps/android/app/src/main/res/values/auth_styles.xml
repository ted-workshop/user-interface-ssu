<resources>
    <style name="Theme.Qletter.Auth" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/auth_text</item>
        <item name="colorOnPrimary">@color/auth_surface</item>
        <item name="colorSurface">@color/auth_surface</item>
        <item name="colorOnSurface">@color/auth_text</item>
        <item name="colorOnSurfaceVariant">@color/auth_secondary</item>
        <item name="colorOutline">@color/auth_outline</item>
        <item name="colorError">@color/auth_error</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/auth_surface</item>
    </style>
    <style name="Widget.Qletter.Auth.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/auth_surface</item>
        <item name="boxStrokeColor">@color/auth_outline</item>
    </style>
    <style name="Widget.Qletter.Auth.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
