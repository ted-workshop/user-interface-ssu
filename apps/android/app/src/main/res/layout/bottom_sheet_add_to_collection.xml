<?xml version="1.0" encoding="utf-8"?>
<!-- 피그마 60:276 모음에 담기 시트: 제목, 설명, 모음 체크 목록, 새 모음 입력, 취소·완료 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingStart="24dp"
  android:paddingTop="24dp"
  android:paddingEnd="24dp"
  android:paddingBottom="28dp">

  <TextView
    style="@style/QletterText.Subhead"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/add_to_collection_title" />

  <TextView
    style="@style/QletterText.Sm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:text="@string/add_to_collection_description" />

  <View
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginTop="12dp"
    android:background="@color/q_line_default" />

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="96dp">

    <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/add_collections_list"
      android:layout_width="match_parent"
      android:layout_height="wrap_content" />

    <ProgressBar
      android:id="@+id/add_loading"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:visibility="gone" />

    <TextView
      android:id="@+id/add_message"
      style="@style/QletterText.Sm"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:gravity="center"
      android:padding="16dp"
      android:visibility="gone" />
  </FrameLayout>

  <!-- 피그마 Signup Pill: 알약 입력칸 안 오른쪽에 만들기 버튼 -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:background="@drawable/q_pill_input"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="5dp">

    <EditText
      android:id="@+id/add_new_name"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:background="@null"
      android:hint="@string/add_to_collection_new_hint"
      android:importantForAutofill="no"
      android:inputType="text"
      android:maxLength="30"
      android:minHeight="48dp"
      android:textColor="@color/q_ink_strong"
      android:textColorHint="@color/q_ink_muted"
      android:textSize="17sp" />

    <Button
      android:id="@+id/add_new_button"
      style="@style/QletterButton.Default"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/collection_create" />
  </LinearLayout>

  <TextView
    android:id="@+id/add_new_error"
    style="@style/QletterText.Xs"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:textColor="@color/q_state_danger"
    android:visibility="gone" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:gravity="end"
    android:orientation="horizontal">

    <Button
      android:id="@+id/add_cancel_button"
      style="@style/QletterButton.Default"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/collection_cancel" />

    <Button
      android:id="@+id/add_done_button"
      style="@style/QletterButton.Primary"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:text="@string/add_to_collection_done" />
  </LinearLayout>
</LinearLayout>
