<?xml version="1.0" encoding="utf-8"?>
<!-- 공통 호스트 테마와 관계없이 인증 화면의 흰 배경을 유지해요. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/auth_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_surface"
    android:fillViewport="true"
    tools:ignore="Overdraw">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/auth_mark_background"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="@string/auth_brand_mark"
                android:textColor="@color/auth_surface"
                android:textSize="12sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/auth_brand"
                android:textColor="@color/auth_text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_back_login"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:text="@string/auth_back_login"
            android:visibility="gone" />
        <TextView
            android:id="@+id/auth_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:accessibilityHeading="true"
            android:text="@string/auth_login_title"
            android:textColor="@color/auth_text"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:targetApi="p" />
        <TextView
            android:id="@+id/auth_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/auth_login_description"
            android:textColor="@color/auth_secondary"
            android:textSize="16sp" />
        <LinearLayout
            android:id="@+id/auth_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/auth_email_layout"
                style="@style/Widget.Qletter.Auth.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/auth_email"
                app:placeholderText="@string/auth_email_placeholder">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/auth_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="username"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:minHeight="56dp"
                    tools:targetApi="o" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/auth_nickname_layout"
                style="@style/Widget.Qletter.Auth.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/auth_nickname"
                android:visibility="gone"
                app:helperText="@string/auth_nickname_helper">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/auth_nickname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="nickname"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:minHeight="56dp"
                    tools:targetApi="o" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/auth_password_layout"
                style="@style/Widget.Qletter.Auth.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/auth_password"
                app:endIconMode="password_toggle">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/auth_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:minHeight="56dp"
                    android:saveEnabled="false"
                    tools:targetApi="o" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/auth_confirmation_layout"
                style="@style/Widget.Qletter.Auth.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/auth_confirmation"
                android:visibility="gone"
                app:endIconMode="password_toggle"
                app:placeholderText="@string/auth_confirmation_placeholder">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/auth_confirmation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:minHeight="56dp"
                    android:saveEnabled="false"
                    tools:targetApi="o" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/auth_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/auth_notice_background"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:textColor="@color/auth_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/auth_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/auth_processing"
            android:indeterminate="true"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_submit"
            style="@style/Widget.Qletter.Auth.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/auth_login" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_resend"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/auth_resend_verification"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/auth_links"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/auth_reset"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/auth_reset_title" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/auth_register"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/auth_register" />
        </LinearLayout>
        <TextView
            android:id="@+id/auth_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/auth_footer"
            android:textColor="@color/auth_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
